{
  "id": "code-artifact",
  "name": "Code Artifact",
  "version": "0.1.0",
  "pluginApi": 1,
  "backend": { "start": "npm start", "healthPath": "/api/health", "readyWhen": "listening" },
  "frontend": { "path": "/", "navLabel": "Code Artifact" },
  "menuItems": [{ "label": "Show artifacts", "scope": "project", "path": "/" }],
  "mcp": {
    "endpoint": "/api/mcp",
    "timeoutMs": 120000,
    "tools": [
      {
        "name": "publish_artifact",
        "description": "Publish a file or directory as a new immutable, versioned artifact and get a link the user can open in cc. The kind is inferred from the source: a .md file is markdown; a .html file, or a directory/.tar.gz with a root index.html, is a static site; a directory/.tar.gz with a root artifact.json ({start, install?, prefix?}) is an app that code-artifact runs for the user: it is published stopped and the user starts it from the link, so publish the source without node_modules; anything else is a downloadable file. Pass project when called from the conductor (its own project is not a user project). To get results back from the user, a static or app page calls `ccArtifact.report(data)` (injected into static HTML; an app loads `/plugins/code-artifact/_page/report.js`), which arrives as a prompt in the publishing session and resolves `{ok, code}`; see docs/protocol.md.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 4096, "description": "Absolute path of the file, directory or .tar.gz to publish." },
            "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Human title shown in the artifact list." },
            "kind": { "type": "string", "enum": ["markdown", "static", "download", "app"], "description": "Override the inferred kind; the source must fit it (app needs a root artifact.json)." },
            "project": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 100, "description": "Owning project. Defaults to the calling session's project; required from the conductor." },
            "sessionId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Publishing session; the session named here receives the version's `ccArtifact.report` data. Defaults to the calling session." }
          },
          "required": ["path", "title"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "kind",
            "project",
            "version",
            "sessionId",
            "link",
            "versionLink",
            "bytes",
            "files"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "markdown",
                "static",
                "download",
                "app"
              ]
            },
            "project": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "description": "The version just published."
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ],
              "description": "The session that receives this version's reports."
            },
            "link": {
              "type": "string",
              "description": "Deep link to the artifact's latest version; give it to the user."
            },
            "versionLink": {
              "type": "string",
              "description": "Deep link pinned to this version."
            },
            "bytes": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            },
            "app": {
              "type": "object",
              "additionalProperties": false,
              "description": "App only; after an update, the state after restarting an active app.",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "stopped",
                    "installing",
                    "starting",
                    "running",
                    "failed"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "name": "update_artifact",
        "description": "Publish a new version of an existing artifact from a new source. Earlier versions stay available. The source must be of the artifact's kind; the project cannot change. The new version's pages report back as described in publish_artifact, to the session named by sessionId.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "artifact": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$", "description": "Artifact id." },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096, "description": "Absolute path of the new source." },
            "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "New title; omit to keep the current one." },
            "kind": { "type": "string", "enum": ["markdown", "static", "download", "app"], "description": "Pass the artifact's kind when the source would otherwise be inferred as another." },
            "sessionId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Publishing session; the session named here receives the version's `ccArtifact.report` data. Defaults to the calling session." }
          },
          "required": ["artifact", "path"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "kind",
            "project",
            "version",
            "sessionId",
            "link",
            "versionLink",
            "bytes",
            "files"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "markdown",
                "static",
                "download",
                "app"
              ]
            },
            "project": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "description": "The version just published."
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ],
              "description": "The session that receives this version's reports."
            },
            "link": {
              "type": "string",
              "description": "Deep link to the artifact's latest version; give it to the user."
            },
            "versionLink": {
              "type": "string",
              "description": "Deep link pinned to this version."
            },
            "bytes": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            },
            "app": {
              "type": "object",
              "additionalProperties": false,
              "description": "App only; after an update, the state after restarting an active app.",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "stopped",
                    "installing",
                    "starting",
                    "running",
                    "failed"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "name": "list_artifacts",
        "description": "List artifacts, newest latest version first, optionally for one project or kind.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 100 },
            "kind": { "type": "string", "enum": ["markdown", "static", "download", "app"] }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifacts"
          ],
          "properties": {
            "artifacts": {
              "type": "array",
              "description": "Newest latest version first.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema",
                  "id",
                  "kind",
                  "project",
                  "title",
                  "createdAt",
                  "nextVersion",
                  "versions",
                  "link"
                ],
                "properties": {
                  "schema": {
                    "type": "integer",
                    "description": "Record format version."
                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "static",
                      "download",
                      "app"
                    ]
                  },
                  "project": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string",
                    "description": "Current title."
                  },
                  "createdAt": {
                    "type": "string",
                    "description": "ISO time."
                  },
                  "nextVersion": {
                    "type": "integer",
                    "description": "Number the next update gets."
                  },
                  "versions": {
                    "type": "array",
                    "description": "Every version, oldest first; the last is the latest.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "n",
                        "title",
                        "publishedAt",
                        "sessionId",
                        "sessionLabel",
                        "source",
                        "bytes",
                        "files",
                        "versionLink"
                      ],
                      "properties": {
                        "n": {
                          "type": "integer",
                          "description": "Version number; never reused."
                        },
                        "title": {
                          "type": "string"
                        },
                        "publishedAt": {
                          "type": "string",
                          "description": "ISO time."
                        },
                        "sessionId": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Publishing session; receives this version's ccArtifact.report data."
                        },
                        "sessionLabel": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "cc's display label for the session, snapshotted at publish."
                        },
                        "source": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "name",
                            "type"
                          ],
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "file",
                                "dir",
                                "tar"
                              ]
                            }
                          }
                        },
                        "file": {
                          "type": "string",
                          "description": "Stored file name (markdown and download only)."
                        },
                        "app": {
                          "type": "object",
                          "additionalProperties": false,
                          "description": "The version's artifact.json (app only).",
                          "required": [
                            "start",
                            "prefix"
                          ],
                          "properties": {
                            "start": {
                              "type": "string"
                            },
                            "install": {
                              "type": "string"
                            },
                            "prefix": {
                              "type": "string",
                              "enum": [
                                "strip",
                                "keep"
                              ]
                            }
                          }
                        },
                        "bytes": {
                          "type": "integer"
                        },
                        "files": {
                          "type": "integer"
                        },
                        "versionLink": {
                          "type": "string",
                          "description": "Deep link pinned to this version."
                        }
                      }
                    }
                  },
                  "link": {
                    "type": "string",
                    "description": "Deep link to the latest version."
                  },
                  "app": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Live process state (app artifacts only).",
                    "required": [
                      "status",
                      "version",
                      "error",
                      "since"
                    ],
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "stopped",
                          "installing",
                          "starting",
                          "running",
                          "failed"
                        ]
                      },
                      "version": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Version the process runs; null when stopped."
                      },
                      "error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "since": {
                        "type": "string",
                        "description": "ISO time of the last state change."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "get_artifact",
        "description": "Get one artifact's full record: every version with its deep link.",
        "inputSchema": {
          "type": "object",
          "properties": { "artifact": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$", "description": "Artifact id." } },
          "required": ["artifact"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "id",
            "kind",
            "project",
            "title",
            "createdAt",
            "nextVersion",
            "versions",
            "link"
          ],
          "properties": {
            "schema": {
              "type": "integer",
              "description": "Record format version."
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "markdown",
                "static",
                "download",
                "app"
              ]
            },
            "project": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "description": "Current title."
            },
            "createdAt": {
              "type": "string",
              "description": "ISO time."
            },
            "nextVersion": {
              "type": "integer",
              "description": "Number the next update gets."
            },
            "versions": {
              "type": "array",
              "description": "Every version, oldest first; the last is the latest.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "n",
                  "title",
                  "publishedAt",
                  "sessionId",
                  "sessionLabel",
                  "source",
                  "bytes",
                  "files",
                  "versionLink"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "description": "Version number; never reused."
                  },
                  "title": {
                    "type": "string"
                  },
                  "publishedAt": {
                    "type": "string",
                    "description": "ISO time."
                  },
                  "sessionId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Publishing session; receives this version's ccArtifact.report data."
                  },
                  "sessionLabel": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "cc's display label for the session, snapshotted at publish."
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "type"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "file",
                          "dir",
                          "tar"
                        ]
                      }
                    }
                  },
                  "file": {
                    "type": "string",
                    "description": "Stored file name (markdown and download only)."
                  },
                  "app": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "The version's artifact.json (app only).",
                    "required": [
                      "start",
                      "prefix"
                    ],
                    "properties": {
                      "start": {
                        "type": "string"
                      },
                      "install": {
                        "type": "string"
                      },
                      "prefix": {
                        "type": "string",
                        "enum": [
                          "strip",
                          "keep"
                        ]
                      }
                    }
                  },
                  "bytes": {
                    "type": "integer"
                  },
                  "files": {
                    "type": "integer"
                  },
                  "versionLink": {
                    "type": "string",
                    "description": "Deep link pinned to this version."
                  }
                }
              }
            },
            "link": {
              "type": "string",
              "description": "Deep link to the latest version."
            },
            "app": {
              "type": "object",
              "additionalProperties": false,
              "description": "Live process state (app artifacts only).",
              "required": [
                "status",
                "version",
                "error",
                "since"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "stopped",
                    "installing",
                    "starting",
                    "running",
                    "failed"
                  ]
                },
                "version": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Version the process runs; null when stopped."
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "since": {
                  "type": "string",
                  "description": "ISO time of the last state change."
                }
              }
            }
          }
        }
      },
      {
        "name": "delete_artifact",
        "description": "Delete a whole artifact, or one version of it when version is given. The only remaining version cannot be deleted on its own.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "artifact": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$", "description": "Artifact id." },
            "version": { "type": "integer", "minimum": 1, "description": "Delete only this version." }
          },
          "required": ["artifact"]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true,
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "deleted",
                "id"
              ],
              "properties": {
                "deleted": {
                  "const": "artifact"
                },
                "id": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "deleted",
                "id",
                "version",
                "latest"
              ],
              "properties": {
                "deleted": {
                  "const": "version"
                },
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "description": "The version removed."
                },
                "latest": {
                  "type": "integer",
                  "description": "The artifact's latest version after the delete."
                }
              }
            }
          ]
        }
      }
    ]
  }
}
